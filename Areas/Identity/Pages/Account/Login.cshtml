@page
@model LoginModel

@{
    ViewData["Title"] = "Secure Login";
    Layout = null; // Use a null layout for a fully custom page design
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewData["Title"]</title>

    <link rel="stylesheet" href="~/css/login-banking.css" />
</head>
<body>
    <div class="login-container">
        <div class="login-card">
            <div class="login-header">
                <div class="logo">
                    <svg width="36" height="36" viewBox="0 0 36 36" fill="none">
                        <rect width="36" height="36" rx="8" fill="#6366F1" />
                        <path d="M12 14h12v8H12v-8zm2 2v4h8v-4h-8zm-2-4h12v2H12v-2zm0 12h12v2H12v-2z" fill="white" />
                    </svg>
                </div>
                <h1>Cow Farm</h1>
                <p>Access your account securely</p>
            </div>

            <form id="account" class="login-form" method="post">

                <div asp-validation-summary="ModelOnly" class="text-danger" style="font-size: 13px; text-align: center; margin-bottom: 15px;" role="alert"></div>

                <div class="form-group">
                    <label asp-for="Input.Email"></label>
                    <input asp-for="Input.Email" class="form-control" required autocomplete="email">
                    <span asp-validation-for="Input.Email" class="error-message"></span>
                </div>

                <div class="form-group">
                    <label asp-for="Input.Password"></label>
                    <div class="password-wrapper">
                        <input asp-for="Input.Password" required autocomplete="current-password">
                        <button type="button" class="password-toggle" id="passwordToggle" aria-label="Toggle password visibility">
                            <svg class="eye-open" width="18" height="18" viewBox="0 0 18 18" fill="none"><path d="M9 3.75C5.25 3.75 2.04 6.24 1.5 9c.54 2.76 3.75 5.25 7.5 5.25s6.96-2.49 7.5-5.25c-.54-2.76-3.75-5.25-7.5-5.25zm0 8.75a3.5 3.5 0 110-7 3.5 3.5 0 010 7zm0-5.5a2 2 0 100 4 2 2 0 000-4z" fill="currentColor" /></svg>
                            <svg class="eye-closed" width="18" height="18" viewBox="0 0 18" fill="none"><path d="M2.25 2.25l13.5 13.5m-4.125-4.125a3 3 0 01-4.243-4.243m4.243 4.243L9 9m2.625 2.625L15 15M9 5.25c1.83 0 3.51.63 4.84 1.68M3.16 6.93A10.97 10.97 0 019 5.25" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" /></svg>
                        </button>
                    </div>
                    <span asp-validation-for="Input.Password" class="error-message"></span>
                </div>

                <div class="form-options">
                    <label class="checkbox-wrapper">
                        <input asp-for="Input.RememberMe" />
                        <span class="checkmark"></span>
                        @Html.DisplayNameFor(m => m.Input.RememberMe)
                    </label>
                    <a asp-page="./ForgotPassword" class="forgot-link">Reset password</a>
                </div>

                <button id="login-submit" type="submit" class="login-btn">
                    <span class="btn-text">Sign In</span>
                    <div class="btn-loader">
                        <div class="spinner"></div>
                    </div>
                </button>
            </form>

            <div style="text-align: center; margin-top: 20px;">
                <a asp-page="./Register" asp-route-returnUrl="@Model.ReturnUrl" class="forgot-link">Don't have an account? Sign up</a>
            </div>

        </div>
    </div>

    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/login-banking.js"></script>
</body>
</html>