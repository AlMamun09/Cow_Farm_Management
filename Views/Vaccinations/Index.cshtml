@{
    ViewData["Title"] = "Vaccination Records";
}

<div class="card card-primary card-outline">
    <div class="card-header">
        <h3 class="card-title">
            <i class="bi bi-eyedropper me-2"></i>
            @ViewData["Title"]
        </h3>
        <div class="card-tools">
            <a asp-action="Create" class="btn btn-primary btn-sm">
                <i class="bi bi-plus-lg me-1"></i> Add Vaccination Record
            </a>
        </div>
    </div>
    <div class="card-body">
        <div class="table-responsive">
            <table id="vaccinationsTable" class="table table-bordered table-hover" style="width:100%">
                <thead>
                    <tr>
                        <th>Cow Tag</th>
                        <th>Vaccine Name</th>
                        <th>Date Given</th>
                        <th>Next Due Date</th>
                        <th style="width: 150px;">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    <!-- Intentionally left empty -->
                </tbody>
            </table>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            // Store the DataTable instance in a variable
            var table = $('#vaccinationsTable').DataTable({
                "ajax": {
                    "url": "@Url.Action("GetVaccinations", "Vaccinations")",
                    "type": "GET",
                    "datatype": "json"
                },
                "columns": [
                    { "data": "cowTagNumber" },
                    { "data": "vaccineName" },
                    { "data": "dateGiven" },
                    { "data": "nextDueDate" },
                    {
                        "data": "id",
                        "className": "text-center",
                        "render": function (data) {
                            // Changed the 'Delete' <a> tag to a <button> with a class and data-id
                            return `<a href="/Vaccinations/Edit/${data}" class="btn btn-secondary btn-sm" title="Edit"><i class="bi bi-pencil-square"></i></a> ` +
                                   `<a href="/Vaccinations/Details/${data}" class="btn btn-info btn-sm ms-1" title="Details"><i class="bi bi-info-circle"></i></a> ` +
                                   `<button type="button" class="btn btn-danger btn-sm ms-1 js-delete" data-id="${data}" title="Delete"><i class="bi bi-trash"></i></button>`;
                        },
                        "orderable": false
                    }
                ]
            });

            // NEW: Event handler for the delete button
            $('#vaccinationsTable').on('click', '.js-delete', function () {
                var button = $(this);
                var recordId = button.data('id');

                Swal.fire({
                  title: "Are you sure?",
                  text: "You won't be able to revert this!",
                  icon: "warning",
                  showCancelButton: true,
                  confirmButtonColor: "#3085d6",
                  cancelButtonColor: "#d33",
                  confirmButtonText: "Yes, delete it!"
                }).then((result) => {
                  if (result.isConfirmed) {
                    $.ajax({
                        url: `/Vaccinations/Delete/${recordId}`,
                        type: 'POST',
                        headers: {
                            "RequestVerificationToken": $('input[name="__RequestVerificationToken"]').val()
                        },
                        success: function(response) {
                            if (response.success) {
                                Swal.fire({
                                  title: "Deleted!",
                                  text: response.message,
                                  icon: "success"
                                });
                                // Refresh the table without reloading the page
                                table.ajax.reload();
                            } else {
                                Swal.fire({
                                  title: "Error!",
                                  text: response.message,
                                  icon: "error"
                                });
                            }
                        }
                    });
                  }
                });
            });
        });
    </script>
}

@* NEW: Add this form to provide the Anti-Forgery Token for security *@
<form asp-action="Delete" asp-controller="Vaccinations" method="post">
    @Html.AntiForgeryToken()
</form>