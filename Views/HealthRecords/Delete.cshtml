@model Cow_Farm.Models.HealthRecord

@{
    ViewData["Title"] = "Delete Health Record";
}

<div class="card card-danger card-outline">
    <div class="card-header">
        <h3 class="card-title text-danger">
            <i class="bi bi-exclamation-triangle-fill me-2"></i>
            Are you sure you want to delete this record?
        </h3>
    </div>
    <div class="card-body">
        <p>You are about to permanently delete the following health record. This action cannot be undone.</p>
        <hr />

        <dl class="row">
            <dt class="col-sm-3 col-md-2">Cow Tag</dt>
            <dd class="col-sm-9 col-md-10">
                @Html.DisplayFor(model => model.Cow.TagNumber)
            </dd>

            <dt class="col-sm-3 col-md-2">Cow Name</dt>
            <dd class="col-sm-9 col-md-10">
                @(Model.Cow?.Name ?? "N/A")
            </dd>

            <dt class="col-sm-3 col-md-2">Record Date</dt>
            <dd class="col-sm-9 col-md-10">
                @Html.DisplayFor(model => model.RecordDate)
            </dd>

            <dt class="col-sm-3 col-md-2">Event Type</dt>
            <dd class="col-sm-9 col-md-10">
                @Html.DisplayFor(model => model.EventType)
            </dd>

            <dt class="col-sm-3 col-md-2">Description</dt>
            <dd class="col-sm-9 col-md-10">
                @Html.DisplayFor(model => model.Description)
            </dd>
            <dt class="col-sm-3 col-md-2">Veterinarian</dt>
            <dd class="col-sm-9 col-md-10">
                @Html.DisplayFor(model => model.Veterinarian)
            </dd>
        </dl>
    </div>
    <div class="card-footer">
        <form asp-action="Delete">
            <input type="hidden" asp-for="Id" />
            <button type="submit" class="btn btn-danger">
                <i class="bi bi-trash-fill me-1"></i> Yes, Delete
            </button>
            <a asp-action="Index" class="btn btn-secondary ms-2">Cancel</a>
        </form>
    </div>
</div>