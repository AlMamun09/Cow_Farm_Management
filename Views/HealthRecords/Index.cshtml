@model IEnumerable<Cow_Farm.Models.HealthRecord>

@{
    ViewData["Title"] = "Health Records";
}

<div class="card card-primary card-outline">
    <div class="card-header">
        <h3 class="card-title">
            <i class="bi bi-heart-pulse me-2"></i>
            @ViewData["Title"]
        </h3>
        <div class="card-tools">
            <a asp-action="Create" class="btn btn-primary btn-sm">
                <i class="bi bi-plus-lg me-1"></i> Add New Record
            </a>
        </div>
    </div>
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-bordered table-hover">
                <thead>
                    <tr>
                        <th>Cow Tag</th>
                        <th>Cow Name</th>
                        <th>Event Type</th>
                        <th>Record Date</th>
                        <th>Description</th>
                        <th>Veterinarian</th>
                        <th style="width: 150px;">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>
                                @if (item.Cow != null)
                                {
                                    <a asp-controller="Cows" asp-action="Details" asp-route-id="@item.CowId">
                                        @Html.DisplayFor(modelItem => item.Cow.TagNumber)
                                    </a>
                                }
                                else
                                {
                                    <span class="text-muted">N/A</span>
                                }
                            </td>
                            <td>@(item.Cow?.Name ?? "N/A")</td>
                            <td>@Html.DisplayFor(modelItem => item.EventType)</td>
                            <td>@Html.DisplayFor(modelItem => item.RecordDate)</td>
                            <td>@Html.DisplayFor(modelItem => item.Description)</td>
                            <td>@(item.Veterinarian ?? "N/A")</td>
                            <td class="text-nowrap">
                                <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-secondary btn-sm" title="Edit">
                                    <i class="bi bi-pencil-square"></i>
                                </a>
                                <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-info btn-sm ms-1" title="Details">
                                    <i class="bi bi-info-circle"></i>
                                </a>
                                <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-danger btn-sm ms-1" title="Delete">
                                    <i class="bi bi-trash"></i>
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>