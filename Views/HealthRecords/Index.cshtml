@{
    ViewData["Title"] = "Health Records";
}

<div class="card card-primary card-outline">
    <div class="card-header">
        <h3 class="card-title">
            <i class="bi bi-heart-pulse me-2"></i>
            @ViewData["Title"]
        </h3>
        <div class="card-tools">
            <a asp-action="Create" class="btn btn-primary btn-sm">
                <i class="bi bi-plus-lg me-1"></i> Add New Record
            </a>
        </div>
    </div>
    <div class="card-body">
        <div class="table-responsive">
            <table id="healthRecordsTable" class="table table-bordered table-hover" style="width:100%">
                <thead>
                    <tr>
                        <th>Cow Tag</th>
                        <th>Cow Name</th>
                        <th>Event Type</th>
                        <th>Record Date</th>
                        <th>Description</th>
                        <th>Veterinarian</th>
                        <th style="width: 150px;">Actions</th>
                    </tr>
                </thead>
                <tbody>
                </tbody>
            </table>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            var table = $('#healthRecordsTable').DataTable({
                "ajax": {
                    "url": "@Url.Action("GetHealthRecords", "HealthRecords")",
                    "type": "GET",
                    "datatype": "json"
                },
                "columns": [
                    { "data": "cowTagNumber" },
                    { "data": "cowName", "render": function (data) { return data ? data : "N/A"; } },
                    { "data": "eventType" },
                    { "data": "recordDate" },
                    { "data": "description" },
                    { "data": "veterinarian", "render": function (data) { return data ? data : "N/A"; } },
                    {
                        "data": "id",
                        "className": "text-center",
                        "render": function (data) {
                            return `<a href="/HealthRecords/Edit/${data}" class="btn btn-secondary btn-sm" title="Edit"><i class="bi bi-pencil-square"></i></a> ` +
                                   `<a href="/HealthRecords/Details/${data}" class="btn btn-info btn-sm ms-1" title="Details"><i class="bi bi-info-circle"></i></a> ` +
                                   `<button type="button" class="btn btn-danger btn-sm ms-1 js-delete" data-id="${data}" title="Delete"><i class="bi bi-trash"></i></button>`;
                        },
                        "orderable": false
                    }
                ]
            });

            $('#healthRecordsTable').on('click', '.js-delete', function () {
                var button = $(this);
                var recordId = button.data('id');

                Swal.fire({
                  title: "Are you sure?",
                  text: "This health record will be permanently deleted.",
                  icon: "warning",
                  showCancelButton: true,
                  confirmButtonColor: "#3085d6",
                  cancelButtonColor: "#d33",
                  confirmButtonText: "Yes, delete it!"
                }).then((result) => {
                  if (result.isConfirmed) {
                    $.ajax({
                        url: '/HealthRecords/Delete/' + recordId,
                        type: 'POST',
                        headers: {
                            "RequestVerificationToken": $('input[name="__RequestVerificationToken"]').val()
                        },
                        success: function(response) {
                            if (response.success) {
                                Swal.fire('Deleted!', response.message, 'success');
                                table.ajax.reload();
                            } else {
                                Swal.fire('Error!', response.message, 'error');
                            }
                        }
                    });
                  }
                });
            });
        });
    </script>
}

<form asp-action="Delete" asp-controller="HealthRecords" method="post">
    @Html.AntiForgeryToken()
</form>