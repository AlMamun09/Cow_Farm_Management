@{
    ViewData["Title"] = "Cow Management";
}

<div class="card card-primary card-outline">
    <div class="card-header">
        <h3 class="card-title">
            <i class="bi bi-grid-fill me-2"></i>
            @ViewData["Title"]
        </h3>
        <div class="card-tools">
            <a asp-action="Create" class="btn btn-primary btn-sm">
                <i class="bi bi-plus-lg me-1"></i> Add New Cow
            </a>
        </div>
    </div>
    <div class="card-body">
        <div class="table-responsive">
            <table id="cowsTable" class="table table-bordered table-hover" style="width:100%">
                <thead>
                    <tr>
                        <th>Tag Number</th>
                        <th>Name</th>
                        <th>Breed</th>
                        <th>Date of Birth</th>
                        <th>Gender</th>
                        <th>Status</th>
                        <th style="width: 150px;">Actions</th>
                    </tr>
                </thead>
                <tbody>
                </tbody>
            </table>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            // Keep a reference to the table
            var table = $('#cowsTable').DataTable({
                "ajax": {
                    "url": "@Url.Action("GetCows", "Cows")",
                    "type": "GET",
                    "datatype": "json"
                },
                "columns": [
                    { "data": "tagNumber" },
                    {
                        "data": "name",
                        "render": function (data) { return data ? data : "N/A"; }
                    },
                    { "data": "breed" },
                    { "data": "birthDate" },
                    { "data": "gender" },
                    { "data": "status" },
                    {
                        "data": "id",
                        "className": "text-center",
                        "render": function (data) {
                            // The delete link is now a button with a class and data-id
                            return `<a href="/Cows/Edit/${data}" class="btn btn-secondary btn-sm" title="Edit"><i class="bi bi-pencil-square"></i></a> ` +
                                   `<a href="/Cows/Details/${data}" class="btn btn-info btn-sm ms-1" title="Details"><i class="bi bi-info-circle"></i></a> ` +
                                   `<button type="button" class="btn btn-danger btn-sm ms-1 js-delete" data-id="${data}" title="Delete"><i class="bi bi-trash"></i></button>`;
                        },
                        "orderable": false
                    }
                ]
            });

            // This is the click handler for our new delete button
            $('#cowsTable').on('click', '.js-delete', function () {
                var button = $(this);
                var cowId = button.data('id');

                Swal.fire({
                  title: "Are you sure?",
                  text: "You won't be able to revert this!",
                  icon: "warning",
                  showCancelButton: true,
                  confirmButtonColor: "#3085d6",
                  cancelButtonColor: "#d33",
                  confirmButtonText: "Yes, delete it!"
                }).then((result) => {
                  if (result.isConfirmed) {
                    // If confirmed, send the AJAX request
                    $.ajax({
                        url: '/Cows/Delete/' + cowId,
                        type: 'POST',
                        headers: {
                            "RequestVerificationToken": $('input[name="__RequestVerificationToken"]').val()
                        },
                        success: function(response) {
                            if (response.success) {
                                Swal.fire('Deleted!', response.message, 'success');
                                // Refresh the table to show the record is gone
                                table.ajax.reload();
                            } else {
                                Swal.fire('Error!', response.message, 'error');
                            }
                        }
                    });
                  }
                });
            });
        });
    </script>
}

@* This hidden form provides the anti-forgery token for security *@
<form asp-action="Delete" asp-controller="Cows" method="post">
    @Html.AntiForgeryToken()
</form>