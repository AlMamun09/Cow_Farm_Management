@* The @model directive is no longer needed for the table but can be kept *@
@model IEnumerable<Cow_Farm.Models.Cow>

@{
    ViewData["Title"] = "Cow Management";
}

<div class="card card-primary card-outline">
    <div class="card-header">
        <h3 class="card-title">
            <i class="bi bi-grid-fill me-2"></i>
            @ViewData["Title"]
        </h3>
        <div class="card-tools">
            <a asp-action="Create" class="btn btn-primary btn-sm">
                <i class="bi bi-plus-lg me-1"></i> Add New Cow
            </a>
        </div>
    </div>
    <div class="card-body">
        <div class="table-responsive">
            <table id="cowsTable" class="table table-bordered table-hover" style="width:100%">
                <thead>
                    <tr>
                        <th>Tag Number</th>
                        <th>Name</th>
                        <th>Breed</th>
                        <th>Date of Birth</th>
                        <th>Gender</th>
                        <th>Status</th>
                        <th style="width: 150px;">Actions</th>
                    </tr>
                </thead>
                <tbody>
                </tbody>
            </table>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            $('#cowsTable').DataTable({
                "ajax": {
                    "url": "@Url.Action("GetCows", "Cows")",
                    "type": "GET",
                    "datatype": "json"
                },
                "columns": [
                    { "data": "tagNumber" },
                    {
                        "data": "name",
                        "render": function (data) {
                            return data ? data : "N/A";
                        }
                    },
                    { "data": "breed" },
                    { "data": "birthDate" },
                    { "data": "gender" },
                    { "data": "status" },
                    {
                        "data": "id",
                        "render": function (data) {
                            return `<a href="/Cows/Edit/${data}" class="btn btn-secondary btn-sm" title="Edit"><i class="bi bi-pencil-square"></i></a> ` +
                                   `<a href="/Cows/Details/${data}" class="btn btn-info btn-sm ms-1" title="Details"><i class="bi bi-info-circle"></i></a> ` +
                                   `<a href="/Cows/Delete/${data}" class="btn btn-danger btn-sm ms-1" title="Delete"><i class="bi bi-trash"></i></a>`;
                        },
                        "orderable": false,
                        "searchable": false,
                        "width": "150px"
                    }
                ]
            });
        });
    </script>
}