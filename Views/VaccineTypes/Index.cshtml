@{
    ViewData["Title"] = "Vaccine Catalog";
}

<div class="card card-primary card-outline">
    <div class="card-header">
        <h3 class="card-title">
            <i class="bi bi-list-task me-2"></i>
            @ViewData["Title"]
        </h3>
        <div class="card-tools">
            <a asp-action="Create" class="btn btn-primary btn-sm">
                <i class="bi bi-plus-lg me-1"></i> Add New Vaccine Type
            </a>
        </div>
    </div>
    <div class="card-body p-0">
        <div class="table-responsive">
            <table id="vaccineTypesTable" class="table table-bordered table-hover">
                <thead>
                    <tr>
                        <th>Vaccine Name</th>
                        <th>Vaccine Manufacturer</th>
                        <th>Price</th>
                        <th>Description</th>
                        <th class="text-center" style="width: 150px;">Actions</th>
                    </tr>
                </thead>
                <tbody>
                </tbody>
            </table>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            const columns = [
                { "data": "name" },
                { "data": "vaccineManufacturer", "defaultContent": "N/A" },
                {
                    "data": "price",
                    "className": "text-end", // Right-align the data in this column
                    "render": function (data, type, row) {
                        return data.toFixed(2) + " Taka";
                    }
                },
                {
                    "data": "description",
                    "defaultContent": "N/A",
                    "render": function (data, type, row) {
                        // Truncate long descriptions and add a tooltip
                        if (data && data.length > 50) {
                            return `<span title="${data}">${data.substring(0, 50)}...</span>`;
                        }
                        return data;
                    }
                },
                {
                    "data": "id",
                    "className": "text-center", // Center-align the buttons
                    "render": function (data, type, row) {
                        return `
                            <a href="/VaccineTypes/Edit/${data}" class="btn btn-secondary btn-sm" title="Edit"><i class="bi bi-pencil-square"></i></a>
                            <a href="/VaccineTypes/Details/${data}" class="btn btn-info btn-sm ms-1" title="Details"><i class="bi bi-info-circle"></i></a>
                            <a href="/VaccineTypes/Delete/${data}" class="btn btn-danger btn-sm ms-1" title="Delete"><i class="bi bi-trash"></i></a>`;
                    },
                    "orderable": false
                }
            ];

            loadTable('vaccineTypesTable', '@Url.Action("GetVaccineTypes", "VaccineTypes")', columns);
        });
    </script>
}